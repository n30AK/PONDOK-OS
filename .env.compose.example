# Admin connection string used ONLY by the migration runner and controlled CLI bootstrap.
# Never pass this owner/BYPASSRLS URL to the API runtime.
DATABASE_URL=postgresql://neondb_owner:ADMIN_PASSWORD@HOST/DB?sslmode=require

# Runtime connection string for the dedicated pondok_app role (NOBYPASSRLS).
# The API container and Neon Function must use this restricted URL.
PONDOK_DATABASE_URL=postgresql://pondok_app:APP_PASSWORD@HOST/DB?sslmode=require

# Neon Auth URLs from the SAME Neon branch as the database URLs.
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=
PONDOK_WEB_PORT=8080

# SHA-256 of a one-time first-organization setup token (64 hex chars). Remove after initialization.
PONDOK_BOOTSTRAP_TOKEN_SHA256=
