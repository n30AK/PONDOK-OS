# Development Neon Auth URL from the Neon development branch only.
VITE_NEON_AUTH_URL=https://ep-billowing-boat-b3junw8u.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth
# Leave blank for Vite's same-origin /v1 proxy to the local API.
# For GitHub Pages, set this to the Neon Function invocation URL.
VITE_API_URL=

# Optional official company WhatsApp Business number in international digits only (e.g. 62812xxxxxxx).
# When configured, PONDOK OS shows a prefilled support link on login and inside the institution workspace.
VITE_SUPPORT_WHATSAPP_NUMBER=
